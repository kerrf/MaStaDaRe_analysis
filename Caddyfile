# Behind Cloudflare, the visitor's address arrives in the header CF-Connecting-IP. Caddy believes it only from
# Cloudflare's own addresses (www.cloudflare.com/ips, as of 10/2026), so the access log's client_ip is the visitor's and
# nobody else can fake it.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

api.mastr-data.de {
	# Access log: a JSON line per request (time, visitor IP and country, path, status, browser, referring page). A new
	# file every day, kept 7 days (the IP addresses are personal data: no longer than needed for security and errors).
	# deploy/api_report.sh turns it into a report.
	log {
		output file /var/log/caddy/api-access.log {
			roll_interval 24h
			roll_keep_for 168h
			mode 0644
		}
		format json
	}
	reverse_proxy backend:8000
}
