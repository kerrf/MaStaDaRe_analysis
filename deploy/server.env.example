# How deploy/push_db.sh and deploy/rollback_db.sh reach the server.
# Copy this file to deploy/server.env (git ignores it) and fill it in once.

# ssh destination: user@host, or a Host alias from ~/.ssh/config
SERVER=root@152.53.185.75

# Where the repo lives on the server (the folder with compose.yml)
REMOTE_DIR=/opt/mastr

# The public API, checked after the switch
API_URL=https://api.mastr-data.de
